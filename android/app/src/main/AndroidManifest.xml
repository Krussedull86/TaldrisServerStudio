    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <application android:label="DZSA Tools" android:theme="@android:style/Theme.Material.NoActionBar" android:icon="@drawable/dzsa_tools" android:allowBackup="false" android:usesCleartextTraffic="false" android:supportsRtl="true">
