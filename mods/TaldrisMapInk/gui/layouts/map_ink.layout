FrameWidgetClass TMI_Root {
 visible 1
 ignorepointer 1
 position 0 0
 size 1 1
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 {
  CanvasWidgetClass TMI_Canvas {
   visible 1
   ignorepointer 1
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
  }
  PanelWidgetClass TMI_Input {
   visible 0
   ignorepointer 0
   color 0 0 0 0
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
  }
  PanelWidgetClass TMI_Toolbar {
   visible 1
   ignorepointer 0
   color 0.07 0.09 0.11 0.92
   position 0.18 0.015
   size 0.64 0.075
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   style DayZDefaultPanel
   {
    ButtonWidgetClass TMI_Toggle {
     position 0.01 0.1
     size 0.115 0.8
     style Editor
     text "INK ON/OFF"
    }
    ButtonWidgetClass TMI_Black {
     position 0.13 0.1
     size 0.075 0.8
     style Editor
     text "BLACK"
    }
    ButtonWidgetClass TMI_Blue {
     position 0.21 0.1
     size 0.075 0.8
     style Editor
     text "BLUE"
    }
    ButtonWidgetClass TMI_Red {
     position 0.29 0.1
     size 0.075 0.8
     style Editor
     text "RED"
    }
    ButtonWidgetClass TMI_Green {
     position 0.37 0.1
     size 0.075 0.8
     style Editor
     text "GREEN"
    }
    ButtonWidgetClass TMI_Undo {
     position 0.455 0.1
     size 0.09 0.8
     style Editor
     text "UNDO"
    }
    ButtonWidgetClass TMI_Save {
     position 0.55 0.1
     size 0.09 0.8
     style Editor
     text "SAVE"
    }
    TextWidgetClass TMI_Status {
     position 0.65 0.1
     size 0.34 0.8
     text "Loading..."
     font "gui/fonts/metron14"
     "text valign" center
    }
   }
  }
 }
